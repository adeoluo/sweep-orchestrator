flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>evaluate, pareto, ..."]:::edge
        Lib(["Python library API"]):::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/sweep /importance"]:::core
        Validate["Validation<br/>count, point vectors"]:::control
        CLI ~~~ Lib ~~~ Client --> Router --> Validate
    end

    subgraph Sched["Scheduling"]
        direction TB
        Problem[("Sweep problem<br/>learning curves")]:::data
        Runner["Sweep runner<br/>thread pool"]:::core
        Pruner{{"Median pruner<br/>stop clear losers"}}:::control
        Hyperband["Hyperband<br/>brackets over eta"]:::core
        Halving["Successive halving<br/>keep best 1/eta"]:::core
        Problem ~~~ Runner --> Pruner
        Pruner ~~~ Hyperband --> Halving
    end

    subgraph Analysis["Trial state and analysis"]
        direction TB
        Store[("Trial store<br/>resumable records")]:::data
        Importance["Parameter importance<br/>variance decomposition"]:::core
        Pareto["Pareto front<br/>non-dominated sort"]:::core
        Store ~~~ Importance ~~~ Pareto
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Compare["Strategy comparison<br/>best loss vs compute"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Compare ~~~ Metrics
    end

    Interfaces -->|configs, count| Sched
    Sched -->|trial records| Analysis
    Sched -->|best loss, compute| Obs
